isClean = preset == "CLEAN"
showExtraVisuals = not isClean and visualDensity != "MINIMAL"
showDenseVisuals = visualDensity == "FULL"

f_size(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Large" ? size.large : size.normal

f_lineStyle(_s) =>
    _s == "DASHED" ? line.style_dashed : _s == "DOTTED" ? line.style_dotted : line.style_solid

f_signalBreakRef(_preference, _bull) =>
    _preference == "Wick" ? (_bull ? high : low) : close

f_trimLineLabelArrays(line[] _lines, label[] _labels, int _max) =>
    if array.size(_lines) > _max
        line.delete(array.shift(_lines))
        label.delete(array.shift(_labels))

f_trimLineArray(line[] _lines, int _max) =>
    if array.size(_lines) > _max
        line.delete(array.shift(_lines))

f_pushStructureMark(line[] _lines, label[] _labels, int _x1, float _y, string _txt, color _col, int _max) =>
    _line = line.new(_x1, _y, bar_index, _y, color=_col, width=structureLineWidth, style=f_lineStyle(structureLineStyleInput))
    _mid = int(math.floor((_x1 + bar_index) * 0.5))
    _label = label.new(_mid, _y, _txt, style=label.style_none, textcolor=_col, size=f_size(tagSizeInput))
    array.push(_lines, _line)
    array.push(_labels, _label)
    f_trimLineLabelArrays(_lines, _labels, _max)

f_trimLiquidityLevels(line[] _lines, label[] _labels, float[] _levels, int[] _types, int[] _starts, int _max) =>
    if array.size(_lines) > _max
        line.delete(array.shift(_lines))
        _oldLabel = array.shift(_labels)
        if not na(_oldLabel)
            label.delete(_oldLabel)
        array.shift(_levels)
        array.shift(_types)
        array.shift(_starts)

f_pushLiquidityLevel(line[] _lines, label[] _labels, float[] _levels, int[] _types, int[] _starts, int _x1, float _y, string _txt, int _type, color _col, int _max) =>
    _line = line.new(_x1, _y, bar_index + baseExtendBars, _y, extend=extend.right, color=color.new(_col, 28), width=1, style=f_lineStyle(liquidityLevelStyleInput))
    label _label = na
    if showLiquidityLevelLabels
        _label := label.new(_x1, _y, _txt, style=label.style_none, textcolor=color.new(_col, 0), size=f_size(tagSizeInput))
    array.push(_lines, _line)
    array.push(_labels, _label)
    array.push(_levels, _y)
    array.push(_types, _type)
    array.push(_starts, _x1)
    f_trimLiquidityLevels(_lines, _labels, _levels, _types, _starts, _max)

f_pushBox(box[] _boxes, label[] _labels, float[] _tops, float[] _bots, int _left, float _top, float _bot, string _txt, color _bg, color _border, int _extend, bool _showLabel, int _max, int _fillOpacity, int _borderWidth) =>
    _box = box.new(_left, _top, bar_index + _extend, _bot, bgcolor=color.new(_bg, _fillOpacity), border_color=color.new(_border, 10), border_width=_borderWidth)
    array.push(_boxes, _box)
    array.push(_tops, _top)
    array.push(_bots, _bot)
    label _label = na
    if _showLabel
        _label := label.new(bar_index + _extend, (_top + _bot) * 0.5, _txt, style=label.style_label_left, color=color.new(_border, 8), textcolor=color.white, size=f_size(tagSizeInput))
    array.push(_labels, _label)
    if array.size(_boxes) > _max
        _oldBox = array.shift(_boxes)
        if not na(_oldBox)
            box.delete(_oldBox)
        _oldLabel = array.shift(_labels)
        if not na(_oldLabel)
            label.delete(_oldLabel)
        array.shift(_tops)
        array.shift(_bots)

f_deleteBoxAt(box[] _boxes, label[] _labels, float[] _tops, float[] _bots, int _idx) =>
    _box = array.get(_boxes, _idx)
    if not na(_box)
        box.delete(_box)
    _label = array.get(_labels, _idx)
    if not na(_label)
        label.delete(_label)
    array.remove(_boxes, _idx)
    array.remove(_labels, _idx)
    array.remove(_tops, _idx)
    array.remove(_bots, _idx)

f_deleteLiquidityLevelAt(line[] _lines, label[] _labels, float[] _levels, int[] _types, int[] _starts, int _idx) =>
    _line = array.get(_lines, _idx)
    if not na(_line)
        line.delete(_line)
    _label = array.get(_labels, _idx)
    if not na(_label)
        label.delete(_label)
    array.remove(_lines, _idx)
    array.remove(_labels, _idx)
    array.remove(_levels, _idx)
    array.remove(_types, _idx)
    array.remove(_starts, _idx)

f_deleteLineAt(line[] _lines, int _idx) =>
    _line = array.get(_lines, _idx)
    if not na(_line)
        line.delete(_line)
    array.remove(_lines, _idx)

f_htfBias(_tf) =>
    _c = request.security(syminfo.tickerid, _tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    _hi = request.security(syminfo.tickerid, _tf, ta.highest(high, 20), barmerge.gaps_off, barmerge.lookahead_off)
    _lo = request.security(syminfo.tickerid, _tf, ta.lowest(low, 20), barmerge.gaps_off, barmerge.lookahead_off)
    _mid = (_hi + _lo) * 0.5
    int _bias = 0
    if _c > _mid
        _bias := 1
    else if _c < _mid
        _bias := -1
    _bias

atr = ta.atr(volatilityLookbackInput)
rsi = ta.rsi(close, 14)
roc = ta.roc(close, 8)
barRange = high - low
bodySize = math.abs(close - open)
closePos = barRange > 0 ? (close - low) / barRange : 0.5

inAsia = useSessions and useAsia and not na(time(timeframe.period, sessAsia, sessionTZ))
inLondon = useSessions and useLondon and not na(time(timeframe.period, sessLondon, sessionTZ))
inNYAM = useSessions and useNYAM and not na(time(timeframe.period, sessNYAM, sessionTZ))
inNYLunch = useSessions and useNYLunch and not na(time(timeframe.period, sessNYLunch, sessionTZ))
inNYPM = useSessions and useNYPM and not na(time(timeframe.period, sessNYPM, sessionTZ))
sessionName = inNYAM ? "NY AM" : inNYLunch ? "NY LUNCH" : inNYPM ? "NY PM" : inLondon ? "LONDON" : inAsia ? "ASIA" : "OFF"

bgcolor(useSessions and showSessionBG and inAsia ? color.new(colAsia, killzoneBoxTransparency) : na)
bgcolor(useSessions and showSessionBG and inLondon ? color.new(colLondon, killzoneBoxTransparency) : na)
bgcolor(useSessions and showSessionBG and inNYAM ? color.new(colNYAM, killzoneBoxTransparency) : na)
bgcolor(useSessions and showSessionBG and inNYLunch ? color.new(colNYLunch, killzoneBoxTransparency) : na)
bgcolor(useSessions and showSessionBG and inNYPM ? color.new(colNYPM, killzoneBoxTransparency) : na)

if useSessions and showSessionTags
    if inAsia and not inAsia[1]
        label.new(bar_index, high, "ASIA", style=label.style_label_down, color=color.new(colAsia, killzoneTextTransparency), textcolor=color.white, size=f_size(sessionLabelSizeInput))
    if inLondon and not inLondon[1]
        label.new(bar_index, high, "LONDON", style=label.style_label_down, color=color.new(colLondon, killzoneTextTransparency), textcolor=color.white, size=f_size(sessionLabelSizeInput))
    if inNYAM and not inNYAM[1]
        label.new(bar_index, high, "NY AM", style=label.style_label_down, color=color.new(colNYAM, killzoneTextTransparency), textcolor=color.white, size=f_size(sessionLabelSizeInput))
    if inNYLunch and not inNYLunch[1]
        label.new(bar_index, high, "NY LUNCH", style=label.style_label_down, color=color.new(colNYLunch, killzoneTextTransparency), textcolor=color.black, size=f_size(sessionLabelSizeInput))
    if inNYPM and not inNYPM[1]
        label.new(bar_index, high, "NY PM", style=label.style_label_down, color=color.new(colNYPM, killzoneTextTransparency), textcolor=color.white, size=f_size(sessionLabelSizeInput))

pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
pdc = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_off, barmerge.lookahead_off)
pmh = request.security(syminfo.tickerid, "M", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pml = request.security(syminfo.tickerid, "M", low[1], barmerge.gaps_off, barmerge.lookahead_off)
emaTrend = ta.ema(close, emaLengthInput)

swingPH = useSMC ? ta.pivothigh(high, swingLen, swingLen) : na
swingPL = useSMC ? ta.pivotlow(low, swingLen, swingLen) : na
internalPH = useSMC ? ta.pivothigh(high, internalLen, internalLen) : na
internalPL = useSMC ? ta.pivotlow(low, internalLen, internalLen) : na

swingPHBar = bar_index - swingLen
swingPLBar = bar_index - swingLen
internalPHBar = bar_index - internalLen
internalPLBar = bar_index - internalLen

var float lastSwingHigh = na
var float prevSwingHigh = na
var int lastSwingHighBar = na
var float lastSwingLow = na
var float prevSwingLow = na
var int lastSwingLowBar = na
var float lastInternalHigh = na
var int lastInternalHighBar = na
var float lastInternalLow = na
var int lastInternalLowBar = na
var int structureState = 0
var int internalState = 0
var line[] structureLines = array.new_line()
var label[] structureLabels = array.new_label()
var line[] eqLines = array.new_line()
var label[] eqLabels = array.new_label()
var line[] liquidityLevelLines = array.new_line()
var label[] liquidityLevelLabels = array.new_label()
var float[] liquidityLevels = array.new_float()
var int[] liquidityTypes = array.new_int()
var int[] liquidityStartBars = array.new_int()
var line[] liquidityEventLines = array.new_line()
var label[] liquidityEventLabels = array.new_label()
var line swingHighLine = na
var line swingLowLine = na

if useSMC and not na(swingPH)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := swingPH
    lastSwingHighBar := swingPHBar
    if showSwingLines and showExtraVisuals
        if not na(swingHighLine)
            line.delete(swingHighLine)
        swingHighLine := line.new(swingPHBar, swingPH, bar_index + 40, swingPH, extend=extend.right, color=color.new(colBear, 10), width=1, style=line.style_dotted)
    if useLiquidity and showLiquidityLevels and showExtraVisuals
        f_pushLiquidityLevel(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, swingPHBar, swingPH, "BSL", 1, colBear, maxLiquidityLevels)

if useSMC and not na(swingPL)
    prevSwingLow := lastSwingLow
    lastSwingLow := swingPL
    lastSwingLowBar := swingPLBar
    if showSwingLines and showExtraVisuals
        if not na(swingLowLine)
            line.delete(swingLowLine)
        swingLowLine := line.new(swingPLBar, swingPL, bar_index + 40, swingPL, extend=extend.right, color=color.new(colBull, 10), width=1, style=line.style_dotted)
    if useLiquidity and showLiquidityLevels and showExtraVisuals
        f_pushLiquidityLevel(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, swingPLBar, swingPL, "SSL", -1, colBull, maxLiquidityLevels)

if useSMC and not na(internalPH)
    lastInternalHigh := internalPH
    lastInternalHighBar := internalPHBar

if useSMC and not na(internalPL)
    lastInternalLow := internalPL
    lastInternalLowBar := internalPLBar

swingHH = useSMC and not na(lastSwingHigh) and not na(prevSwingHigh) and lastSwingHigh > prevSwingHigh
swingLH = useSMC and not na(lastSwingHigh) and not na(prevSwingHigh) and lastSwingHigh < prevSwingHigh
swingHL = useSMC and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingLow > prevSwingLow
swingLL = useSMC and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingLow < prevSwingLow

if useSMC and showSwingPoints and showExtraVisuals
    if not na(swingPH)
        if swingHH
            label.new(swingPHBar, swingPH, "HH", style=label.style_label_down, color=color.new(colBull, 20), textcolor=color.black, size=f_size(tagSizeInput))
        if swingLH
            label.new(swingPHBar, swingPH, "LH", style=label.style_label_down, color=color.new(colBear, 20), textcolor=color.white, size=f_size(tagSizeInput))
    if not na(swingPL)
        if swingHL
            label.new(swingPLBar, swingPL, "HL", style=label.style_label_up, color=color.new(colBull, 20), textcolor=color.black, size=f_size(tagSizeInput))
        if swingLL
            label.new(swingPLBar, swingPL, "LL", style=label.style_label_up, color=color.new(colBear, 20), textcolor=color.white, size=f_size(tagSizeInput))

swingBullBOS = useSMC and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
swingBearBOS = useSMC and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
swingBullCHoCH = structureState == -1 and swingBullBOS
swingBearCHoCH = structureState == 1 and swingBearBOS

if swingBullBOS
    if showStructureMarks and showExtraVisuals
        f_pushStructureMark(structureLines, structureLabels, lastSwingHighBar, lastSwingHigh, swingBullCHoCH ? "CHOCH" : "BOS", swingBullCHoCH ? colAqua : colBull, maxStructureMarks)
    structureState := 1

if swingBearBOS
    if showStructureMarks and showExtraVisuals
        f_pushStructureMark(structureLines, structureLabels, lastSwingLowBar, lastSwingLow, swingBearCHoCH ? "CHOCH" : "BOS", swingBearCHoCH ? color.fuchsia : colBear, maxStructureMarks)
    structureState := -1

internalBullBOS = useSMC and not na(lastInternalHigh) and close > lastInternalHigh and close[1] <= lastInternalHigh
internalBearBOS = useSMC and not na(lastInternalLow) and close < lastInternalLow and close[1] >= lastInternalLow
internalBullCHoCH = internalState == -1 and internalBullBOS
internalBearCHoCH = internalState == 1 and internalBearBOS

if internalBullBOS
    if showInternalMarks and showExtraVisuals
        f_pushStructureMark(structureLines, structureLabels, lastInternalHighBar, lastInternalHigh, internalBullCHoCH ? "iCHOCH" : "iBOS", color.new(colBull, 20), maxStructureMarks)
    internalState := 1

if internalBearBOS
    if showInternalMarks and showExtraVisuals
        f_pushStructureMark(structureLines, structureLabels, lastInternalLowBar, lastInternalLow, internalBearCHoCH ? "iCHOCH" : "iBOS", color.new(colBear, 20), maxStructureMarks)
    internalState := -1

eqTol = atr * eqToleranceAtr
newEqHigh = useSMC and showEQ and not na(swingPH) and not na(lastSwingHigh) and not na(prevSwingHigh) and math.abs(lastSwingHigh - prevSwingHigh) <= eqTol
newEqLow = useSMC and showEQ and not na(swingPL) and not na(lastSwingLow) and not na(prevSwingLow) and math.abs(lastSwingLow - prevSwingLow) <= eqTol

if newEqHigh and showExtraVisuals
    _eqLine = line.new(lastSwingHighBar, lastSwingHigh, bar_index + 40, lastSwingHigh, extend=extend.right, color=color.new(colBear, 20), width=1, style=line.style_dashed)
    _eqLabel = label.new(bar_index + 40, lastSwingHigh, "EQH", style=label.style_label_left, color=color.new(colBear, 8), textcolor=color.white, size=f_size(tagSizeInput))
    array.push(eqLines, _eqLine)
    array.push(eqLabels, _eqLabel)
    f_trimLineLabelArrays(eqLines, eqLabels, maxEQMarks)

if newEqLow and showExtraVisuals
    _eqLine = line.new(lastSwingLowBar, lastSwingLow, bar_index + 40, lastSwingLow, extend=extend.right, color=color.new(colBull, 20), width=1, style=line.style_dashed)
    _eqLabel = label.new(bar_index + 40, lastSwingLow, "EQL", style=label.style_label_left, color=color.new(colBull, 8), textcolor=color.white, size=f_size(tagSizeInput))
    array.push(eqLines, _eqLine)
    array.push(eqLabels, _eqLabel)
    f_trimLineLabelArrays(eqLines, eqLabels, maxEQMarks)

recentHigh = useLiquidity ? ta.highest(high[1], sweepLookback) : na
recentLow = useLiquidity ? ta.lowest(low[1], sweepLookback) : na
rawBullSweep = useLiquidity and low < recentLow and close > recentLow and close > open and closePos > 0.55
rawBearSweep = useLiquidity and high > recentHigh and close < recentHigh and close < open and closePos < 0.45
bullPDSweep = useLiquidity and low < pdl and close > pdl
bearPDSweep = useLiquidity and high > pdh and close < pdh

levelBullSweep = false
levelBearSweep = false

if useLiquidity and showPivotSweeps and showExtraVisuals and array.size(liquidityLevelLines) > 0
    for i = array.size(liquidityLevelLines) - 1 to 0
        _level = array.get(liquidityLevels, i)
        _type = array.get(liquidityTypes, i)
        _start = array.get(liquidityStartBars, i)
        if _type == 1
            if high > _level and close < _level
                levelBearSweep := true
                if showSweepMarkers
                    f_pushStructureMark(liquidityEventLines, liquidityEventLabels, _start, _level, "BSL SWEEP", colBear, maxStructureMarks)
                f_deleteLiquidityLevelAt(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, i)
            else if close > _level
                f_deleteLiquidityLevelAt(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, i)
        else
            if low < _level and close > _level
                levelBullSweep := true
                if showSweepMarkers
                    f_pushStructureMark(liquidityEventLines, liquidityEventLabels, _start, _level, "SSL SWEEP", colBull, maxStructureMarks)
                f_deleteLiquidityLevelAt(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, i)
            else if close < _level
                f_deleteLiquidityLevelAt(liquidityLevelLines, liquidityLevelLabels, liquidityLevels, liquidityTypes, liquidityStartBars, i)

bullSweep = (showLookbackSweeps and rawBullSweep) or (showPivotSweeps and levelBullSweep)
bearSweep = (showLookbackSweeps and rawBearSweep) or (showPivotSweeps and levelBearSweep)

plotshape(showSweepMarkers and bullSweep and not bullPDSweep, title="Bull Sweep", style=shape.triangleup, location=location.belowbar, color=colAqua, size=size.tiny)
plotshape(showSweepMarkers and bearSweep and not bearPDSweep, title="Bear Sweep", style=shape.triangledown, location=location.abovebar, color=colAqua, size=size.tiny)
plotshape(showSweepMarkers and bullPDSweep, title="PDL Sweep", style=shape.labelup, location=location.belowbar, color=color.new(colBull, 0), text="PDL", textcolor=color.white, size=size.tiny)
plotshape(showSweepMarkers and bearPDSweep, title="PDH Sweep", style=shape.labeldown, location=location.abovebar, color=color.new(colBear, 0), text="PDH", textcolor=color.white, size=size.tiny)

bullFVGNow = useImbalances and low > high[2] and (low - high[2]) >= atr * imbalanceMinAtr
bearFVGNow = useImbalances and high < low[2] and (low[2] - high) >= atr * imbalanceMinAtr

var box[] bullFvgBoxes = array.new_box()
var label[] bullFvgLabels = array.new_label()
var float[] bullFvgTops = array.new_float()
var float[] bullFvgBots = array.new_float()
var box[] bearFvgBoxes = array.new_box()
var label[] bearFvgLabels = array.new_label()
var float[] bearFvgTops = array.new_float()
var float[] bearFvgBots = array.new_float()
var box[] bullIfvgBoxes = array.new_box()
var label[] bullIfvgLabels = array.new_label()
var float[] bullIfvgTops = array.new_float()
var float[] bullIfvgBots = array.new_float()
var line[] bullIfvgMidLines = array.new_line()
var box[] bearIfvgBoxes = array.new_box()
var label[] bearIfvgLabels = array.new_label()
var float[] bearIfvgTops = array.new_float()
var float[] bearIfvgBots = array.new_float()
var line[] bearIfvgMidLines = array.new_line()

if bullFVGNow and showFVGBoxes and showBullFVGBoxes
    f_pushBox(bullFvgBoxes, bullFvgLabels, bullFvgTops, bullFvgBots, bar_index - 2, low, high[2], "BULL FVG", colBullFvg, colBullFvg, imbalanceExtendBars, showImbalanceLabels and showExtraVisuals, maxFvgBoxes, fvgBoxOpacity, imbalanceBorderWidth)

if bearFVGNow and showFVGBoxes and showBearFVGBoxes
    f_pushBox(bearFvgBoxes, bearFvgLabels, bearFvgTops, bearFvgBots, bar_index - 2, low[2], high, "BEAR FVG", colBearFvg, colBearFvg, imbalanceExtendBars, showImbalanceLabels and showExtraVisuals, maxFvgBoxes, fvgBoxOpacity, imbalanceBorderWidth)

if array.size(bullFvgBoxes) > 0
    for i = array.size(bullFvgBoxes) - 1 to 0
        _top = array.get(bullFvgTops, i)
        _bot = array.get(bullFvgBots, i)
        _flip = close < _bot
        _fill = fvgFillMode == "Wick" ? low <= _bot : close <= _bot
        if _flip
            if showIFVGBoxes and showBearIFVGBoxes
                f_pushBox(bearIfvgBoxes, bearIfvgLabels, bearIfvgTops, bearIfvgBots, bar_index, _top, _bot, "BEAR IFVG", colBearIfvg, colBearIfvg, imbalanceExtendBars, showImbalanceLabels and showExtraVisuals, maxIfvgBoxes, ifvgBoxOpacity, imbalanceBorderWidth)
                if showIFVGMidline
                    array.push(bearIfvgMidLines, line.new(bar_index, (_top + _bot) * 0.5, bar_index + imbalanceExtendBars, (_top + _bot) * 0.5, extend=extend.right, color=color.new(color.white, 45), width=1, style=line.style_dashed))
                    f_trimLineArray(bearIfvgMidLines, maxIfvgBoxes)
            f_deleteBoxAt(bullFvgBoxes, bullFvgLabels, bullFvgTops, bullFvgBots, i)
        else if _fill and deleteFilledFVG
            f_deleteBoxAt(bullFvgBoxes, bullFvgLabels, bullFvgTops, bullFvgBots, i)

if array.size(bearFvgBoxes) > 0
    for i = array.size(bearFvgBoxes) - 1 to 0
        _top = array.get(bearFvgTops, i)
        _bot = array.get(bearFvgBots, i)
        _flip = close > _top
        _fill = fvgFillMode == "Wick" ? high >= _top : close >= _top
        if _flip
            if showIFVGBoxes and showBullIFVGBoxes
                f_pushBox(bullIfvgBoxes, bullIfvgLabels, bullIfvgTops, bullIfvgBots, bar_index, _top, _bot, "BULL IFVG", colBullIfvg, colBullIfvg, imbalanceExtendBars, showImbalanceLabels and showExtraVisuals, maxIfvgBoxes, ifvgBoxOpacity, imbalanceBorderWidth)
                if showIFVGMidline
                    array.push(bullIfvgMidLines, line.new(bar_index, (_top + _bot) * 0.5, bar_index + imbalanceExtendBars, (_top + _bot) * 0.5, extend=extend.right, color=color.new(color.white, 45), width=1, style=line.style_dashed))
                    f_trimLineArray(bullIfvgMidLines, maxIfvgBoxes)
            f_deleteBoxAt(bearFvgBoxes, bearFvgLabels, bearFvgTops, bearFvgBots, i)
        else if _fill and deleteFilledFVG
            f_deleteBoxAt(bearFvgBoxes, bearFvgLabels, bearFvgTops, bearFvgBots, i)

if array.size(bullIfvgBoxes) > 0
    for i = array.size(bullIfvgBoxes) - 1 to 0
        _bot = array.get(bullIfvgBots, i)
        if close < _bot
            f_deleteBoxAt(bullIfvgBoxes, bullIfvgLabels, bullIfvgTops, bullIfvgBots, i)
            if array.size(bullIfvgMidLines) > i
                f_deleteLineAt(bullIfvgMidLines, i)

if array.size(bearIfvgBoxes) > 0
    for i = array.size(bearIfvgBoxes) - 1 to 0
        _top = array.get(bearIfvgTops, i)
        if close > _top
            f_deleteBoxAt(bearIfvgBoxes, bearIfvgLabels, bearIfvgTops, bearIfvgBots, i)
            if array.size(bearIfvgMidLines) > i
                f_deleteLineAt(bearIfvgMidLines, i)

bullFvgActive = array.size(bullFvgBoxes) > 0
bearFvgActive = array.size(bearFvgBoxes) > 0
bullIfvgActive = array.size(bullIfvgBoxes) > 0
bearIfvgActive = array.size(bearIfvgBoxes) > 0

bullIfvgSignal = false
bearIfvgSignal = false
bullBreakRef = f_signalBreakRef(ifvgSignalPreference, true)
bearBreakRef = f_signalBreakRef(ifvgSignalPreference, false)

if showIFVGSignals and array.size(bullIfvgBoxes) > 0
    for i = array.size(bullIfvgBoxes) - 1 to 0
        _top = array.get(bullIfvgTops, i)
        _bot = array.get(bullIfvgBots, i)
        _retest = low <= _top and high >= _bot
        _reject = _retest and bullBreakRef > _top and open < _top
        if _reject
            bullIfvgSignal := true

if showIFVGSignals and array.size(bearIfvgBoxes) > 0
    for i = array.size(bearIfvgBoxes) - 1 to 0
        _top = array.get(bearIfvgTops, i)
        _bot = array.get(bearIfvgBots, i)
        _retest = high >= _bot and low <= _top
        _reject = _retest and bearBreakRef < _bot and open > _bot
        if _reject
            bearIfvgSignal := true

bullEngulfRaw = useEngulfing and close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearEngulfRaw = useEngulfing and close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bullEngulf = bullEngulfRaw and (not engulfRequireZone or bullSweep or bullPDSweep or bullFvgActive or bullIfvgActive) and (not engulfRequireStructure or structureState == 1 or swingBullCHoCH)
bearEngulf = bearEngulfRaw and (not engulfRequireZone or bearSweep or bearPDSweep or bearFvgActive or bearIfvgActive) and (not engulfRequireStructure or structureState == -1 or swingBearCHoCH)

engulfMarkersEnabled = showEngulfMarkers and engulfDisplayMode != "OFF" and engulfDisplayMode != "BAR COLOR"
engulfSizeTiny = engulfMarkerSizeInput == "Tiny"
engulfSizeSmall = engulfMarkerSizeInput == "Small"
engulfSizeNormal = engulfMarkerSizeInput == "Normal"
engulfSizeLarge = engulfMarkerSizeInput == "Large"

plotshape(engulfMarkersEnabled and bullEngulf and engulfSizeTiny, title="Bull Engulf Tiny", style=shape.triangleup, location=location.belowbar, color=color.new(colBull, 0), size=size.tiny)
plotshape(engulfMarkersEnabled and bullEngulf and engulfSizeSmall, title="Bull Engulf Small", style=shape.triangleup, location=location.belowbar, color=color.new(colBull, 0), size=size.small)
plotshape(engulfMarkersEnabled and bullEngulf and engulfSizeNormal, title="Bull Engulf Normal", style=shape.triangleup, location=location.belowbar, color=color.new(colBull, 0), size=size.normal)
plotshape(engulfMarkersEnabled and bullEngulf and engulfSizeLarge, title="Bull Engulf Large", style=shape.triangleup, location=location.belowbar, color=color.new(colBull, 0), size=size.large)
plotshape(engulfMarkersEnabled and bearEngulf and engulfSizeTiny, title="Bear Engulf Tiny", style=shape.triangledown, location=location.abovebar, color=color.new(colBear, 0), size=size.tiny)
plotshape(engulfMarkersEnabled and bearEngulf and engulfSizeSmall, title="Bear Engulf Small", style=shape.triangledown, location=location.abovebar, color=color.new(colBear, 0), size=size.small)
plotshape(engulfMarkersEnabled and bearEngulf and engulfSizeNormal, title="Bear Engulf Normal", style=shape.triangledown, location=location.abovebar, color=color.new(colBear, 0), size=size.normal)
plotshape(engulfMarkersEnabled and bearEngulf and engulfSizeLarge, title="Bear Engulf Large", style=shape.triangledown, location=location.abovebar, color=color.new(colBear, 0), size=size.large)
barcolor(showEngulfMarkers and (engulfDisplayMode == "BOTH" or engulfDisplayMode == "BAR COLOR") and bullEngulf ? color.new(colBull, 62) : showEngulfMarkers and (engulfDisplayMode == "BOTH" or engulfDisplayMode == "BAR COLOR") and bearEngulf ? color.new(colBear, 62) : na)
plotshape(showIFVGSignals and bullIfvgSignal, title="Bull IFVG Signal", style=shape.triangleup, location=location.belowbar, color=colBullIfvg, size=size.tiny)
plotshape(showIFVGSignals and bearIfvgSignal, title="Bear IFVG Signal", style=shape.triangledown, location=location.abovebar, color=colBearIfvg, size=size.tiny)

rangeMid = useSMC and showPremiumDiscount and not na(lastSwingHigh) and not na(lastSwingLow) ? (lastSwingHigh + lastSwingLow) * 0.5 : na
pdState = not na(rangeMid) ? (close < rangeMid ? "DISCOUNT" : close > rangeMid ? "PREMIUM" : "EQ") : "N/A"

plot(showEMAOverlay ? emaTrend : na, "EMA", color=color.new(colEMA, 0), linewidth=2, style=plot.style_linebr)
plot(useLiquidity and showPDLevels and showPreviousDayHLOverlay ? pdh : na, "PDH", color=color.new(colBear, 10), linewidth=1, style=plot.style_linebr)
plot(useLiquidity and showPDLevels and showPreviousDayHLOverlay ? pdl : na, "PDL", color=color.new(colBull, 10), linewidth=1, style=plot.style_linebr)
plot(useLiquidity and showPDLevels and showExtraVisuals ? pdc : na, "PDC", color=color.new(colGold, 18), linewidth=1, style=plot.style_linebr)
plot(showPreviousWeekHLOverlay ? pwh : na, "PWH", color=color.new(colBear, 35), linewidth=1, style=plot.style_linebr)
plot(showPreviousWeekHLOverlay ? pwl : na, "PWL", color=color.new(colBull, 35), linewidth=1, style=plot.style_linebr)
plot(showPreviousMonthHLOverlay ? pmh : na, "PMH", color=color.new(colBear, 55), linewidth=1, style=plot.style_linebr)
plot(showPreviousMonthHLOverlay ? pml : na, "PML", color=color.new(colBull, 55), linewidth=1, style=plot.style_linebr)
plot(showPremiumDiscount and showExtraVisuals ? rangeMid : na, "EQ MID", color=color.new(colNeutral, 55), linewidth=1, style=plot.style_linebr)

var label lblPDH = na
var label lblPDL = na
var label lblPDC = na
var label lblEQ = na
var label lblPWH = na
var label lblPWL = na
var label lblPMH = na
var label lblPML = na

if barstate.islast and showEndLabels
    label.delete(lblPDH)
    label.delete(lblPDL)
    label.delete(lblPDC)
    label.delete(lblEQ)
    label.delete(lblPWH)
    label.delete(lblPWL)
    label.delete(lblPMH)
    label.delete(lblPML)
    if useLiquidity and showPDLevels
        if showPreviousDayHLOverlay
            lblPDH := label.new(bar_index + 1, pdh, "PDH", style=label.style_label_left, color=colBear, textcolor=color.white, size=f_size(tagSizeInput))
            lblPDL := label.new(bar_index + 1, pdl, "PDL", style=label.style_label_left, color=colBull, textcolor=color.white, size=f_size(tagSizeInput))
        if showExtraVisuals
            lblPDC := label.new(bar_index + 1, pdc, "PDC", style=label.style_label_left, color=colGold, textcolor=color.black, size=f_size(tagSizeInput))
    if showPreviousWeekHLOverlay
        lblPWH := label.new(bar_index + 1, pwh, "PWH", style=label.style_label_left, color=color.new(colBear, 20), textcolor=color.white, size=f_size(tagSizeInput))
        lblPWL := label.new(bar_index + 1, pwl, "PWL", style=label.style_label_left, color=color.new(colBull, 20), textcolor=color.white, size=f_size(tagSizeInput))
    if showPreviousMonthHLOverlay
        lblPMH := label.new(bar_index + 1, pmh, "PMH", style=label.style_label_left, color=color.new(colBear, 35), textcolor=color.white, size=f_size(tagSizeInput))
        lblPML := label.new(bar_index + 1, pml, "PML", style=label.style_label_left, color=color.new(colBull, 35), textcolor=color.white, size=f_size(tagSizeInput))
    if showPremiumDiscount and showExtraVisuals and not na(rangeMid)
        lblEQ := label.new(bar_index + 1, rangeMid, "EQ", style=label.style_label_left, color=color.new(colNeutral, 5), textcolor=color.white, size=f_size(tagSizeInput))

htf1Bias = f_htfBias("60")
htf2Bias = f_htfBias("240")

structureText = structureState == 1 ? "BULLISH" : structureState == -1 ? "BEARISH" : "NEUTRAL"
lastSwingText = swingHH ? "HH" : swingHL ? "HL" : swingLH ? "LH" : swingLL ? "LL" : "N/A"
internalText = internalBullCHoCH ? "BULL CHOCH" : internalBearCHoCH ? "BEAR CHOCH" : internalBullBOS ? "BULL BOS" : internalBearBOS ? "BEAR BOS" : "QUIET"
liquidityText = bullPDSweep ? "PDL SWEEP" : bearPDSweep ? "PDH SWEEP" : levelBullSweep ? "SSL SWEEP" : levelBearSweep ? "BSL SWEEP" : bullSweep ? "BULL SWEEP" : bearSweep ? "BEAR SWEEP" : "NONE"
imbalanceText = bullIfvgActive ? "BULL IFVG" : bearIfvgActive ? "BEAR IFVG" : bullFvgActive ? "BULL FVG" : bearFvgActive ? "BEAR FVG" : "NONE"
rsiText = str.tostring(rsi, "#.##") + (rsi >= 70 ? " OB" : rsi <= 30 ? " OS" : "")
htfText = htf2Bias == 1 and htf1Bias == 1 ? "BULL" : htf2Bias == -1 and htf1Bias == -1 ? "BEAR" : "MIXED"
sweepText = levelBullSweep ? "SSL" : levelBearSweep ? "BSL" : bullPDSweep ? "PDL" : bearPDSweep ? "PDH" : bullSweep ? "BULL" : bearSweep ? "BEAR" : "NONE"
zonesText = "FVG " + str.tostring(array.size(bullFvgBoxes) + array.size(bearFvgBoxes)) + " | IFVG " + str.tostring(array.size(bullIfvgBoxes) + array.size(bearIfvgBoxes))
signalText = bullIfvgSignal ? "BULL IFVG" : bearIfvgSignal ? "BEAR IFVG" : bullEngulf ? "BULL ENG" : bearEngulf ? "BEAR ENG" : swingBullCHoCH ? "BULL CHOCH" : swingBearCHoCH ? "BEAR CHOCH" : "QUIET"
pdLevelsText = "H " + str.tostring(pdh, "#") + " / L " + str.tostring(pdl, "#")
eqText = not na(rangeMid) ? str.tostring(rangeMid, "#.##") : "N/A"

f_cell(table _t, int _c, int _r, string _txt, color _bg, color _tc) =>
    table.cell(_t, _c, _r, _txt, bgcolor=_bg, text_color=_tc)

var table dash = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 12), border_color=color.new(colNeutral, 70))
if useDashboard and showDashboard and barstate.islast
    f_cell(dash, 0, 0, dashboardCompact ? "MKT STRUCTURE" : "MARKET STRUCTURE", color.new(color.black, 45), color.white)
    f_cell(dash, 1, 0, "STACK v3", color.new(color.black, 10), color.white)
    f_cell(dash, 0, 1, "BIAS", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 1, structureText, structureState == 1 ? color.new(colBull, 72) : structureState == -1 ? color.new(colBear, 72) : color.new(colNeutral, 82), color.white)
    f_cell(dash, 0, 2, "HTF", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 2, dashboardShowHTF ? htfText : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 3, "SWING", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 3, dashboardCompact ? structureText : structureText + " | " + lastSwingText, color.new(color.black, 16), color.white)
    f_cell(dash, 0, 4, "INTERNAL", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 4, dashboardShowInternal ? internalText : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 5, "LIQUIDITY", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 5, dashboardShowLiquidity ? liquidityText : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 6, "SWEEPS", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 6, dashboardCompact ? sweepText : sweepText + " | " + pdLevelsText, color.new(color.black, 16), color.white)
    f_cell(dash, 0, 7, "IMBALANCE", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 7, dashboardShowImbalance ? imbalanceText : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 8, "ZONES", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 8, dashboardCompact ? imbalanceText : zonesText, color.new(color.black, 16), color.white)
    f_cell(dash, 0, 9, "SESSION", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 9, dashboardShowSession ? sessionName : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 10, "RSI / PD", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 10, dashboardShowRsiPd ? rsiText + " | " + pdState + " | EQ " + eqText : "-", color.new(color.black, 16), color.white)
    f_cell(dash, 0, 11, "SIGNAL", color.new(color.gray, 84), color.white)
    f_cell(dash, 1, 11, signalText, color.new(color.black, 16), color.white)

alertcondition(swingBullBOS, "SMC Bull BOS", "Bull BOS on {{ticker}} {{interval}}")
alertcondition(swingBearBOS, "SMC Bear BOS", "Bear BOS on {{ticker}} {{interval}}")
alertcondition(swingBullCHoCH, "SMC Bull CHOCH", "Bull CHOCH on {{ticker}} {{interval}}")
alertcondition(swingBearCHoCH, "SMC Bear CHOCH", "Bear CHOCH on {{ticker}} {{interval}}")
alertcondition(bullPDSweep, "PDL Sweep", "Bullish sweep of previous day low")
alertcondition(bearPDSweep, "PDH Sweep", "Bearish sweep of previous day high")
alertcondition(bullFVGNow, "Bull FVG", "Bull FVG on {{ticker}} {{interval}}")
alertcondition(bearFVGNow, "Bear FVG", "Bear FVG on {{ticker}} {{interval}}")
alertcondition(bullEngulf, "Bull Engulf", "Bull engulfing on {{ticker}} {{interval}}")
alertcondition(bearEngulf, "Bear Engulf", "Bear engulfing on {{ticker}} {{interval}}")
